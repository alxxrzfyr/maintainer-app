[Unit]
Description=Maintainer privileged helper
Documentation=https://github.com/alxxrzfyr/maintainer-app
# Activated on demand by D-Bus. There is deliberately no [Install] section, so
# the helper is never enabled at boot and never becomes a permanent daemon.

[Service]
Type=dbus
BusName=io.github.maintainerapp.Helper
ExecStart=/usr/libexec/maintainer-helper
User=root

# The helper must stay root: it signals processes, cleans the APT cache and
# vacuums the journal. Privileges cannot be dropped, so the sandbox instead
# removes everything it has no reason to reach.

# Filesystem is read-only apart from the two caches it is allowed to empty.
StateDirectory=maintainer
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/cache/apt /var/log/journal
ProtectHome=yes
PrivateTmp=yes

# The helper never needs to gain privileges beyond those it starts with, and
# the programs it runs (apt-get, journalctl) are not setuid.
NoNewPrivileges=yes

# No operation contacts the network. SMART data is read over the system bus,
# which is a unix socket and unaffected by this.
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# ProtectProc is deliberately left at its default. Terminating a process
# revalidates the target by reading /proc/<pid>/stat, so hiding other processes
# would break the PID-reuse guard.

# A stuck or hostile request cannot starve the machine. The helper is small and
# short-lived; these bounds are far above what any operation needs.
MemoryMax=128M
CPUQuota=25%
TasksMax=32
